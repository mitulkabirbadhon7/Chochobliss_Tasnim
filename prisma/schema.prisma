generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
  GUEST
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BannerType {
  PROMO
  ANNOUNCEMENT
  ALERT
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  phone          String?
  avatarUrl      String?
  role           Role           @default(CUSTOMER)
  cocoaPoints    Int            @default(0)
  authProvider   String         @default("credentials")
  authProviderId String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  addresses      Address[]
  orders         Order[]
  wishlist       WishlistItem[]
  reviews        Review[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String   @default("Home")
  fullName   String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("Bangladesh")
  phone      String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Product {
  id              String         @id @default(cuid())
  name            String
  slug            String         @unique
  description     String         @db.Text
  price           Decimal        @db.Decimal(10, 2)
  salePrice       Decimal?       @db.Decimal(10, 2)
  sku             String         @unique
  inventory       Int            @default(0)
  cacaoPercentage Int?
  origin          String?
  flavorNotes     String[]
  ingredients     String?        @db.Text
  allergens       String[]
  weight          String?
  images          String[]
  category        String         @default("Bars")
  isFeatured      Boolean        @default(false)
  isPublished     Boolean        @default(true)
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  reviews         Review[]

  @@index([slug])
  @@index([category])
  @@index([isPublished, isFeatured])
  @@index([deletedAt])
  @@map("products")
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING)
  paymentMethod       String        @default("CARD")
  subtotal            Decimal       @db.Decimal(10, 2)
  shippingFee         Decimal       @db.Decimal(10, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount         Decimal       @db.Decimal(10, 2)
  cocoaPointsEarned   Int           @default(0)
  cocoaPointsRedeemed Int           @default(0)
  shippingAddress     Json
  giftNote            String?       @db.Text
  trackingNumber      String?
  notes               String?       @db.Text
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user                User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items               OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  unitPrice    Decimal  @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal  @db.Decimal(10, 2)

  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Review {
  id         String   @id @default(cuid())
  userId     String
  productId  String
  rating     Int
  title      String?
  comment    String   @db.Text
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
  @@index([userId])
  @@map("reviews")
}

model Announcement {
  id          String     @id @default(cuid())
  title       String
  content     String     @db.Text
  bannerType  BannerType @default(PROMO)
  linkUrl     String?
  bannerImage String?
  isActive    Boolean    @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, startDate, endDate])
  @@map("announcements")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  title     String
  content   Json
  mediaUrl  String?
  updatedAt DateTime @updatedAt

  @@index([key])
  @@map("site_contents")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  category  String   @default("GENERAL") // COMPLAINT, INQUIRY, FEEDBACK, CUSTOM_ORDER, GENERAL
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@map("contact_messages")
}

